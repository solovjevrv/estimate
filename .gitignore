# Зависимости
node_modules/

# Сборка и артефакты
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.eslintcache

# Загруженные аватарки (10.15) — локальное хранилище для dev/e2e, на проде отдельный volume
apps/server/avatars/
# Картинки, загруженные на доски в дев-режиме (13.2) — рантайм-данные, не код
apps/server/board-assets/

# Типы, которые генерирует плагин Nuxt UI при каждой сборке
apps/web/auto-imports.d.ts
apps/web/components.d.ts

# Тесты
playwright-report/
test-results/

# Окружение и секреты
.env
.env.*
!.env.example
credentials.md
cloudflare.ini

# Локальные файлы агента (в репозиторий не попадают)
claude.md
CLAUDE.md
AGENTS.md
.agents/
PROGRESS.md
PROGRESS_ARCHIVE.md
PROGRESS_ARCHIVE/
PROGRESS_BUGS.md
REFACTORING_PLAN.md
REVIEW_*.md

# Дизайн-референсы (мокапы Claude Design и т.п.) — рабочий материал, не код
.design/
.claude/*
# Скиллы держим в репозитории — это общая для команды справка по Nuxt UI
!.claude/skills/

# Логи
*.log
npm-debug.log*
pnpm-debug.log*

# ОС и IDE
.DS_Store
.idea/
.vscode/
