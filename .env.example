# Скопируйте в .env — значения ниже подходят для локальной разработки.
# Внимание: при смене POSTGRES_PORT/логина/пароля поменяйте их и внутри DATABASE_URL.
# Пароль — без URL-спецсимволов (@ : / # %), он подставляется в DATABASE_URL как есть.
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker
POSTGRES_PORT=5432
DATABASE_URL=postgres://poker:poker@localhost:5432/poker

# Документация API: по умолчанию включена везде, кроме NODE_ENV=production
# DOCS_ENABLED=true

# --- Аутентификация ---
# Секрет подписи JWT, от 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=
# Внешний адрес сервера: из него собирается redirect_uri для OAuth.
# Именно этот адрес (а не адрес дев-фронта) регистрируется в кабинете провайдера:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/yandex/callback
PUBLIC_ORIGIN=http://localhost:3000
# Куда вернуть браузер после входа (дев-фронт Vite)
WEB_ORIGIN=http://localhost:5173
# Флаг Secure у кук сессии. По умолчанию включается, если PUBLIC_ORIGIN на https.
# COOKIE_SECURE=false
# OAuth-приложение Google (console.cloud.google.com). Пусто — вход через Google выключен.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth-приложение Яндекса (oauth.yandex.ru). Пусто — вход через Яндекс выключен.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Sentry (ошибки/логи бэкенда + uptime-монитор /health), sentry.io. Пусто — выключено.
SENTRY_DSN=
