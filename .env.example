# Скопируйте в .env — значения ниже подходят для локальной разработки.
# Внимание: при смене POSTGRES_PORT/логина/пароля поменяйте их и внутри DATABASE_URL.
# Пароль — без URL-спецсимволов (@ : / # %), он подставляется в DATABASE_URL как есть.
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
POSTGRES_DB=poker
POSTGRES_PORT=5432
DATABASE_URL=postgres://poker:poker@localhost:5432/poker
